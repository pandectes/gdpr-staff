# --- Session / PIN login -----------------------------------------------------
# Any long random string. Rotating it signs everyone out and kills pending PINs.
SESSION_SECRET=change-me-to-a-long-random-string
# Comma separated allowlist. Anything not here cannot request a PIN.
STAFF_EMAILS=nikos@pandectes.io,panos@pandectes.io
SESSION_MAX_AGE=28800
PIN_TTL=600
PIN_MAX_ATTEMPTS=5

# --- GDPR app database (read-only user) --------------------------------------
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- Email (AWS SES) ---------------------------------------------------------
# Leave the credentials empty in development and the PIN is printed to the server log.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-west-2
EMAIL_NO_REPLY=no-reply@pandectes.io

APP_NAME=Pandectes Staff
